{
  "name": "p4linventory-frontend",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-tokens.mjs",
    "test": "vitest run --reporter=dot",
    "audit": "npm audit --audit-level=high",
    "contract:drift": "node scripts/contract-drift.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run contract:drift && npm run design:check && npm run test && npm run audit && npm run build && npm run verify:dist",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "contract:sync": "node scripts/contract-sync.mjs",
    "contract:gen": "openapi-typescript contract/openapi.yaml -o src/api/schema.d.ts"
  },
  "type": "module",
  "dependencies": {
    "@ant-design/colors": "8.0.1",
    "@ant-design/icons": "6.2.3",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@mui/material": "9.0.1",
    "@mui/system": "9.0.1",
    "@mui/x-charts": "9.2.0",
    "@tanstack/react-query": "5.108.4",
    "framer-motion": "12.39.0",
    "lodash-es": "4.18.1",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-device-detect": "2.2.3",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.6",
    "simplebar-react": "3.3.2",
    "swr": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-axe": "0.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  }
}
