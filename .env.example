# p4linventory-frontend environment variables (Vite exposes only VITE_* to the browser).
# Copy to .env.local for local use. Real .env files are git-ignored.
# Every value below is a dummy placeholder. Never put a secret here: anything
# prefixed VITE_ ends up in the public JavaScript bundle.

# Base URL of the eqp4l-backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Use MSW mock responses instead of the real backend (true/false)
VITE_USE_MOCKS=true

# Error monitoring (Sentry). Leave the DSN empty locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
