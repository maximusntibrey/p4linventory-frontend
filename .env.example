# p4linventory-frontend environment variables (Vite exposes only VITE_* to the browser).
# Copy to .env.local for local use (optional: the defaults below already work).
# Real .env files are git-ignored. Every value is a dummy/default. Never put a secret
# here: anything prefixed VITE_ ends up in the public JavaScript bundle.

# API mode: real (default) uses the backend through the dev proxy; mock uses MSW.
# Mock mode is wired up in F1.4; until then it behaves like real.
VITE_API_MODE=real

# Where the Vite dev server forwards /api, /health, /admin and /static (dev only).
# Start the backend first. Default: http://127.0.0.1:8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL of the API as the browser sees it. Keep it relative locally so the dev
# proxy gives one origin (cookies and CSRF just work). Production sets an absolute URL.
VITE_API_BASE_URL=/api/v1

# Error monitoring (Sentry). Leave the DSN empty locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
