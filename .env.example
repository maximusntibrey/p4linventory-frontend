# real = talk to the backend; mock = MSW responses for isolated tests
VITE_API_MODE=real
# Backend URL the Vite dev proxy forwards /api, /media and /health to (local dev: same-origin, no CORS needed)
VITE_BACKEND_URL=http://localhost:8000
# Production builds only: the backend's public HTTPS origin (set before building, e.g. on Railway).
# VITE_API_URL=https://api.example.com
# Dev only: call VITE_API_URL cross-origin instead of the proxy, to exercise CORS the way production does.
# VITE_API_DIRECT=true
